# Sao chép file này thành .env.local và điền giá trị của bạn.
# Bản v1 chạy hoàn toàn bằng localStorage nên KHÔNG bắt buộc biến nào dưới đây.

# URL công khai của app (dùng để tạo link chia sẻ tuyệt đối). VD khi deploy Vercel:
# NEXT_PUBLIC_APP_URL=https://thiep-cuoi-online.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — BƯỚC TIẾP THEO, chưa bắt buộc ở bản chạy local.
# Khi bạn đã có project Supabase, điền 2 biến dưới đây rồi mới viết code kết nối thật.
# Hiện tại code KHÔNG gọi Supabase (không có code giả vờ kết nối).
# LƯU Ý: lên Vercel production mà chưa có Supabase thì mọi route đọc/ghi
# trả lỗi 503 rõ ràng thay vì lặng lẽ mất dữ liệu (file JSON local không
# sống được trên Vercel). Chưa có project Supabase nào cho Thiệp Đôi —
# project Supabase hiện có là của app Sổ Tiền, KHÔNG được dùng chung.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bán thiệp online — PLAN CHỐT v3-final (2026-11-06) ---
# Giá thiệp online: 100.000đ / thiệp, một giá cho mọi mẫu.
# Đổi giá thì sửa biến này, không sửa code.
NEXT_PUBLIC_ONLINE_PRICE_VND=100000

# SePay gói FREE (0đ/tháng, 50 giao dịch tiền vào/tháng) — Nancy tự tạo tài
# khoản SePay + nối tài khoản Vietcombank DÀNH RIÊNG cho tiền online (không
# dùng tài khoản chính nhận tiền vật lý, vì SePay tính 50 giao dịch trên
# TOÀN BỘ tiền vào tài khoản đó trong tháng).
# Chưa điền các biến dưới thì endpoint thanh toán trả configured:false và
# KHÔNG sinh QR giả.
SEPAY_BANK_CODE=VCB
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# Secret webhook SePay — Nancy đặt giá trị này trong dashboard SePay, rồi
# điền cùng giá trị vào đây (và vào biến môi trường Vercel khi deploy).
# Webhook không đúng secret thì bị từ chối. Chưa đặt secret thì webhook chỉ
# chạy local để test, production từ chối.
SEPAY_WEBHOOK_SECRET=

# Token admin — CHỈ Nancy giữ. Dùng cho: chốt in, mở khóa, tạo link khách,
# đối soát tay. Chưa đặt thì local cho qua để test, production bắt buộc có.
THIEP_ADMIN_TOKEN=
